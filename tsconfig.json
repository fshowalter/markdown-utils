{
  "exclude": ["dist/**", "coverage/**", "content/**"],
  "compilerOptions": {
    "types": ["node"],
    // Enable top-level await, and other modern ESM features.
    "target": "ESNext",
    // Resolve exactly the way Node does at runtime: honour package `exports` maps and
    // require explicit file extensions on relative imports. This is what keeps the
    // package importable from plain Node with no build step -- an extensionless
    // relative import is now a type error rather than something only a bundler forgives.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Enable JSON imports.
    "resolveJsonModule": true,
    // Nothing is emitted; tsc is a type-checker only.
    "noEmit": true,
    // Report an error when importing a file using a casing different from another import of the same file.
    "forceConsistentCasingInFileNames": true,
    // Properly support importing CJS modules in ESM
    "esModuleInterop": true,
    // Skip typechecking libraries and .d.ts files
    "skipLibCheck": true,
    // Allow JavaScript files to be imported
    "allowJs": true,
    // Type-check those JavaScript files using their JSDoc annotations. This is what
    // replaces TypeScript syntax once the sources are converted.
    "checkJs": true,
    // Enable all strict type-checking options. Without strictNullChecks in particular,
    // JSDoc type annotations catch very little.
    "strict": true
  }
}
