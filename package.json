{
  "name": "markdown-utils",
  "type": "module",
  "version": "1.0.1",
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "check": "tsc",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "knip": "knip",
    "lint": "eslint  .",
    "lint:fix": "eslint --fix .",
    "test:coverage": "node --test --experimental-test-coverage './src/**/*.test.js'",
    "test": "node --test './src/**/*.test.js'"
  },
  "main": "index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "src",
    "types",
    "!src/**/*.test.js"
  ],
  "dependencies": {
    "js-yaml": "5.5.0",
    "satteri": "0.11.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-unicorn": "79.0.0",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "knip": {
    "ignore": [
      "types/**"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
